#!/bin/sh
# MiniBox MFP service discovery for HP LaserJet M1522n.
# Publishes driverless-friendly DNS-SD records without usblp/CUPS.

set -eu

HOST="${MINIBOX_HOSTNAME:-minibox-mfp}"
MODEL="${MINIBOX_MODEL:-HP LaserJet M1522n}"
PORT="${MINIBOX_PRINT_PORT:-9100}"
SCAN_PORT="${MINIBOX_SCAN_PORT:-6566}"
PIDDIR=/var/run/minibox-discovery

mkdir -p "$PIDDIR"

cleanup() {
    for f in "$PIDDIR"/*.pid; do
        [ -f "$f" ] || continue
        kill "$(cat "$f")" 2>/dev/null || true
    done
    rm -rf "$PIDDIR"
}
trap cleanup EXIT INT TERM

publish() {
    name="$1"; type="$2"; port="$3"; shift 3
    avahi-publish-service "$name" "$type" "$port" "$@" &
    echo $! > "$PIDDIR/$(echo "$type" | tr -cd '[:alnum:]').pid"
}

command -v avahi-publish-service >/dev/null 2>&1 || {
    echo "minibox-discovery: avahi-publish-service missing" >&2
    exit 1
}

# Raw JetDirect-compatible queue for Windows and legacy clients.
publish "$MODEL @ $HOST" _pdl-datastream._tcp "$PORT" \
    "txtvers=1" "qtotal=1" "ty=$MODEL" "product=($MODEL)" \
    "note=MiniBox MFP USB bridge" "pdl=application/octet-stream"

# Scanner advertisement. scand owns the actual network endpoint.
publish "$MODEL Scanner @ $HOST" _sane-port._tcp "$SCAN_PORT" \
    "txtvers=1" "ty=$MODEL" "note=MiniBox MFP scanner"

# Generic device identity used by phone/desktop discovery.
publish "$MODEL @ $HOST" _http._tcp 80 \
    "path=/" "model=$MODEL" "usb_vid=03f0" "usb_pid=4517"

wait
